digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.65", splines=polyline, fontname="DejaVu Sans", labelloc=t, fontsize=20, label="Queryable effects and infection episodes\nExtensions to the core model; multiple values are stored as separate rows."];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#728397", arrowsize=0.65, fontname="DejaVu Sans", fontsize=10];
"Medication" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>Medication</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK MedicationID</FONT></TD></TR></TABLE>>];
"Treatment" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>Treatment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK TreatmentID</FONT></TD></TR></TABLE>>];
"SideEffect" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>SideEffect</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK SideEffectID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Unique EffectName</FONT></TD></TR></TABLE>>];
"MedicationSideEffect" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>MedicationSideEffect</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK/FK MedicationID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK/FK SideEffectID</FONT></TD></TR></TABLE>>];
"TreatmentSideEffect" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>TreatmentSideEffect</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK/FK TreatmentID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK/FK SideEffectID</FONT></TD></TR></TABLE>>];
"Hospitalization" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>Hospitalization</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK/FK EncounterID</FONT></TD></TR></TABLE>>];
"HospitalInfection" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>HospitalInfection</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK HospitalInfectionID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK EncounterID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK InfectionTypeID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">DetectedDate, HospitalAcquired</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">ResolvedDate (optional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Organism and clinical note</FONT></TD></TR></TABLE>>];
"InfectionType" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>InfectionType</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK InfectionTypeID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Unique TypeName</FONT></TD></TR></TABLE>>];
"Medication" -> "MedicationSideEffect" [label="1 : many"];
"SideEffect" -> "MedicationSideEffect" [label="1 : many"];
"Treatment" -> "TreatmentSideEffect" [label="1 : many"];
"SideEffect" -> "TreatmentSideEffect" [label="1 : many"];
"Hospitalization" -> "HospitalInfection" [label="1 : many"];
"InfectionType" -> "HospitalInfection" [label="1 : many"];
}
