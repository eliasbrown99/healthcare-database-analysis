digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.65", splines=polyline, fontname="DejaVu Sans", labelloc=t, fontsize=20, label="Original Access relationships\nArrows run from referenced parent to child. All seven relationships are 1 to many."];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#728397", arrowsize=0.65, fontname="DejaVu Sans", fontsize=10];
"Patient" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#663E3E"><FONT COLOR="white"><B>Patient</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK PatientID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Name and demographics</FONT></TD></TR></TABLE>>];
"Hospitalization" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#663E3E"><FONT COLOR="white"><B>Hospitalization</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK PatientCareID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Admission and discharge dates</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">No PatientID field</FONT></TD></TR></TABLE>>];
"PatientTreatment" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#663E3E"><FONT COLOR="white"><B>PatientTreatment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK PatientTreatmentID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK PatientID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK PatientCareID (optional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK TreatmentID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">InPatient flag</FONT></TD></TR></TABLE>>];
"Physician" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#663E3E"><FONT COLOR="white"><B>Physician</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK PhysicianID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Specialty</FONT></TD></TR></TABLE>>];
"PhysicianTreatment" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#663E3E"><FONT COLOR="white"><B>PhysicianTreatment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK/FK PhysicianID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK/FK PatientTreatmentID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Role</FONT></TD></TR></TABLE>>];
"Treatment" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#663E3E"><FONT COLOR="white"><B>Treatment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK TreatmentID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">SideEffects text list</FONT></TD></TR></TABLE>>];
"Medication" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#663E3E"><FONT COLOR="white"><B>Medication</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK MedicationID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">SideEffects text list</FONT></TD></TR></TABLE>>];
"PatientTreatmentMedication" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#663E3E"><FONT COLOR="white"><B>PatientTreatmentMedication</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK PatientTreatmentMedicationID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK PatientTreatmentID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK MedicationID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Dosage</FONT></TD></TR></TABLE>>];
"Medication" -> "PatientTreatmentMedication" [label="1 : many"];
"Hospitalization" -> "PatientTreatment" [label="1 : many"];
"Patient" -> "PatientTreatment" [label="1 : many"];
"PatientTreatment" -> "PatientTreatmentMedication" [label="1 : many"];
"PatientTreatment" -> "PhysicianTreatment" [label="1 : many"];
"Physician" -> "PhysicianTreatment" [label="1 : many"];
"Treatment" -> "PatientTreatment" [label="1 : many"];
}
