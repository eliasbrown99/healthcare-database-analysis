digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.65", splines=polyline, fontname="DejaVu Sans", labelloc=t, fontsize=20, label="Revised care and medication model\nOne patient per encounter. Responsibility is mandatory; additional clinicians are optional."];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#728397", arrowsize=0.65, fontname="DejaVu Sans", fontsize=10];
"Patient" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>Patient</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK PatientID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Name and demographics</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Separate contact name / relationship / phone</FONT></TD></TR></TABLE>>];
"Physician" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>Physician</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK PhysicianID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Specialty</FONT></TD></TR></TABLE>>];
"Treatment" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>Treatment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK TreatmentID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Name and description</FONT></TD></TR></TABLE>>];
"Encounter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>Encounter</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK EncounterID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK PatientID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Type, dates, visit reason</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Generated required-subtype reference</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Disposition and follow-up</FONT></TD></TR></TABLE>>];
"Hospitalization" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>Hospitalization</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK/FK EncounterID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Falls and care metrics</FONT></TD></TR></TABLE>>];
"PatientTreatment" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>PatientTreatment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK PatientTreatmentID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK EncounterID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK TreatmentID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK ResponsiblePhysicianID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Treatment dates</FONT></TD></TR></TABLE>>];
"PhysicianTreatment" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>PhysicianTreatment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK/FK PhysicianID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK/FK PatientTreatmentID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Additional clinician role</FONT></TD></TR></TABLE>>];
"Medication" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>Medication</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK MedicationID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">MedicationName</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">StandardDosage reference text</FONT></TD></TR></TABLE>>];
"MedicationOrder" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1"><TR><TD BGCOLOR="#163A5F"><FONT COLOR="white"><B>MedicationOrder</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">PK MedicationOrderID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK PatientTreatmentID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK MedicationID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">FK PrescribingPhysicianID</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F8FC"><FONT POINT-SIZE="11">Dose, frequency, date, indication</FONT></TD></TR></TABLE>>];
"Patient" -> "Encounter" [label="1 : many"];
"Encounter" -> "Hospitalization" [label="inpatient: exactly 1 at commit"];
"Encounter" -> "PatientTreatment" [label="1 : many"];
"Treatment" -> "PatientTreatment" [label="1 : many"];
"Physician" -> "PatientTreatment" [label="responsible / 1 : many"];
"Physician" -> "PhysicianTreatment" [label="1 : many"];
"PatientTreatment" -> "PhysicianTreatment" [label="1 : many"];
"PatientTreatment" -> "MedicationOrder" [label="1 : many"];
"Medication" -> "MedicationOrder" [label="1 : many"];
"Physician" -> "MedicationOrder" [label="prescriber / 1 : many"];
}
